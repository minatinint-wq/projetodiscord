{
  "name": "sesh",
  "version": "1.2.0",
  "description": "Sesh - comunidades, voz, vídeo e compartilhamento",
  "author": "Sesh",
  "private": true,
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run web\"",
    "web": "vite --host 127.0.0.1",
    "server": "node server.js",
    "desktop": "concurrently --kill-others-on-fail \"npm run web\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "preview": "vite preview",
    "electron": "electron .",
    "db:import": "node scripts/import-database.js",
    "test": "node --test",
    "test:ui": "playwright test"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "latest",
    "animejs": "^4.5.0",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "emoji-picker-react": "^4.22.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "ws": "latest"
  },
  "build": {
    "appId": "com.sesh.desktop",
    "productName": "Sesh",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server.js",
      "image-generation.js",
      "game-catalog.js",
      "game-artwork.js",
      "cosmetics.js",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "icon": "public/branding/sesh.ico",
      "target": [
        "portable"
      ],
      "artifactName": "SeshDesktop.${ext}"
    }
  }
}
