{
  "name": "sesh",
  "version": "1.3.0",
  "description": "Sesh - comunidades, voz, vídeo e compartilhamento",
  "author": "Sesh",
  "private": true,
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run web\"",
    "web": "vite --host 127.0.0.1",
    "server": "node server.js",
    "desktop": "concurrently --kill-others-on-fail \"npm run web\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:publish": "npm run build && electron-builder --win nsis --x64 --publish always",
    "android:sync": "npm run build && cap sync android",
    "dist:android": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview",
    "electron": "electron .",
    "db:import": "node scripts/import-database.js",
    "test": "node --test",
    "test:ui": "playwright test"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "latest",
    "animejs": "^4.5.0",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "emoji-picker-react": "^4.22.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron-updater": "6.6.2",
    "pg": "^8.23.0",
    "ws": "latest"
  },
  "build": {
    "appId": "com.sesh.desktop",
    "productName": "Sesh",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "server.js",
      "game-catalog.js",
      "cosmetics.js",
      "avatar-decorations.js",
      "nameplates.js",
      "profile-art.js",
      "profile-frames.js",
      "image-generation.js",
      "package.json"
    ],
    "win": {
      "icon": "public/branding/sesh.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "SeshDesktop-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sesh Desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "minatinint-wq",
        "repo": "projetodiscord",
        "releaseType": "release"
      }
    ]
  }
}
