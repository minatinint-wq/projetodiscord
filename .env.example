# O Sesh usa JSON local por padrão. Não é preciso configurar nada para testar.
HOST=127.0.0.1
PORT=3001
SEED_DEMO_USER=true

# Opcional no desenvolvimento: chave AES-256 em base64 (32 bytes).
# No aplicativo Windows a chave é criada automaticamente e protegida pelo sistema.
# DATA_ENCRYPTION_KEY=

# Defina somente se o frontend estiver em outra origem.
# CORS_ORIGIN=http://127.0.0.1:5173

# PostgreSQL é opcional. Nunca grave credenciais reais neste arquivo ou no Git.
# DATABASE_URL=postgres://usuario:senha@host:5432/database
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Conta que pode administrar insígnias e recebe a badge exclusiva de Criador.
# CREATOR_EMAIL=admin@exemplo.com

# E-mails que podem cadastrar um nome de usuário com 3 ou mais caracteres.
# Configure valores reais apenas no painel do provedor, separados por vírgula.
# SHORT_USERNAME_EMAILS=convidada@exemplo.com

# Conta administradora principal. Essa conta recebe a tag exclusiva #0001.
# Use valores reais somente no painel de variáveis do Render, nunca no Git.
# MASTER_ADMIN_EMAIL=admin@exemplo.com
# MASTER_ADMIN_PASSWORD=uma-senha-longa-e-unica

# URL pública usada apenas pelo cron de heartbeat no Render.
# SESH_PUBLIC_URL=https://seu-sesh.onrender.com

# Aplicativo Windows: URL HTTPS do manifesto releases/latest.json.
# Ao publicar um pacote maior, o Sesh pergunta se o usuário quer atualizar.
# SESH_UPDATE_MANIFEST_URL=https://seu-sesh.onrender.com/releases/latest.json

# E-mails transacionais (confirmação e recuperação). Configure no Render, nunca no Git.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=Sesh <acesso@seu-dominio.com>

# Gerador privado IA SESH. Somente donos/cargos com "Gerenciar servidor" podem usar.
# A resposta não é salva nem transmitida aos outros membros.
AI_IMAGE_DAILY_LIMIT=5
IMAGE_GENERATION_TIMEOUT_MS=55000

# /image: os provedores configurados são tentados nesta ordem.
# Se nenhuma chave estiver configurada, usa este Space público como fallback.
# NORMAL_HF_SPACE_URL=https://black-forest-labs-flux-1-schnell.hf.space
# NORMAL_HF_API_NAME=infer
# HF_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
# NVIDIA_IMAGE_API_URL=
# NVIDIA_IMAGE_API_TOKEN=
# NVIDIA_IMAGE_MODEL=
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# NORMAL_IMAGE_API_URL=
# NORMAL_IMAGE_API_TOKEN=
# NORMAL_IMAGE_MODEL=

# /imagensfw: rota adulta separada. O Space abaixo pode ser testado anonimamente,
# sujeito à política e à pequena cota diária do Hugging Face ZeroGPU.
# NSFW_HF_SPACE_URL=https://black-forest-labs-flux-1-schnell.hf.space
# NSFW_HF_API_NAME=infer
# NSFW_IMAGE_WIDTH=768
# NSFW_IMAGE_HEIGHT=768
# NSFW_IMAGE_STEPS=4
# Alternativa: provedor JSON próprio que aceite { prompt, model }.
